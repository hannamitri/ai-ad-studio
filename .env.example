# See spec/02-ARCHITECTURE.md → Environment variables.
# Copy this file to `.env.local` and fill in real values. Never commit secrets.

# Public site URL (used for auth redirects, OG, magic links)
NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
TEXT_MODEL=            # current small GPT model, JSON-capable
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_PROVIDER=openai  # or gemini
GOOGLE_API_KEY=        # only if IMAGE_PROVIDER=gemini

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=

# Cost controls
GEN_DAILY_CAP=3
REFINE_DAILY_CAP=6
ANON_GEN_CAP=1
ANON_REFINE_CAP=2
GENERATION_ENABLED=true

# Screen 9 CTAs
BOOKING_URL=
PRECALL_VIDEO_URL=

# Studio daily-cap secondary CTA → the program page (PRD §5)
PROGRAM_URL=

# Flow session cookie signing secret
FLOW_COOKIE_SECRET=
